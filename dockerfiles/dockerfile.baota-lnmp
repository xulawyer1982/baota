ARG BASE_TAG=minimal
FROM registry.cn-shanghai.aliyuncs.com/xulawyer985/baota:${BASE_TAG}
LABEL maintainer="eyunzhu <mail@eyunzhu.com>"

ENV DEBIAN_FRONTEND=noninteractive

# aarch64 编译 MySQL 5.7 的 locale 修复（否则 make Error 2）
RUN localedef -i en_US -f UTF-8 en_US.UTF-8 2>/dev/null || true
RUN sed -i 's/^export LANG=en_US.UTF-8/export LANG=C.UTF-8/' /www/server/panel/install/public.sh

# aarch64 没有官方预编译包，全部走编译安装（install_soft.sh 第 1 个参数 0=编译，1/4=极速）

RUN tar xzf /www_backup.tar.gz -C / \
    && rm -rf /www_backup.tar.gz \
    && cd /www/server/panel/install \
    && bash install_soft.sh 0 install php 7.4 \
    && bash install_soft.sh 0 install redis 74 \
    && bash install_soft.sh 0 install fileinfo 74 \
    && bash install_soft.sh 0 install mbstring 74 \
    && bash install_soft.sh 0 install nginx 1.28 \
    && bash install_soft.sh 0 install mysql 5.7 \
    && bash install_soft.sh 0 install phpmyadmin 5.1 \
    && rm -rf /www/server/mysql/mysql-test \
    && rm -rf /www/server/mysql/lib/libmysqld.a \
    && rm -rf /www/server/mysql/bin/*embedded \
    && rm -rf /www/server/mysql/bin/mysqlxtest \
    && rm -rf /root/.cache/pip \
    && rm -rf /www/reserve_space.pl \
    && rm -rf /www/server/data/ib_logfile* \
    && tar czf /www_backup.tar.gz -C / www \
    && rm -rf /www \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /var/log/* \
    && rm -rf /tmp/*

STOPSIGNAL SIGRTMIN+3
